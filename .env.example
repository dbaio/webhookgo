# Copy to .env to override the defaults used by docker-compose.yml.

# Run the image published on GitHub Container Registry. `always` pulls the
# newest build of main on every `docker compose up -d`; use a version tag such
# as :1 to stay on a release. Comment both lines out to build from source.
IMAGE=ghcr.io/dbaio/webhookgo:latest
PULL_POLICY=always

# Host port the app is published on. Use 127.0.0.1:8080 to only accept local
# connections (e.g. behind nginx on the same host).
PORT=8080

# Public base URL shown for webhook URLs (set it when running behind a domain
# or reverse proxy, e.g. https://hooks.example.com). Empty = the browser origin.
PUBLIC_URL=

# Name shown in the UI and the browser tab.
APP_NAME=webhookgo

# Requests and bytes kept per URL; the oldest requests are dropped beyond either.
MAX_REQUESTS=500
MAX_URL_STORAGE=64MB

# A URL and its requests expire after this long without use (e.g. 72h, 7d, 30d).
TOKEN_TTL=7d

# Bytes of each request body that are stored (larger bodies are truncated).
MAX_BODY_SIZE=2MB

# Maximum response delay (seconds) a URL can be configured with.
MAX_DELAY=30

# Per client IP, per minute (0 = unlimited): captured requests, new URLs, API calls.
RATE_LIMIT=600
TOKEN_RATE_LIMIT=30
API_RATE_LIMIT=1200

# Abuse handling (/abuse page). A record of each URL (creator IP and user agent,
# request count, who deleted it) is kept this long after the URL expires or is
# deleted; 0 keeps none. ABUSE_CONTACT (an email or URL) is shown on the page.
AUDIT_RETENTION=180d
ABUSE_CONTACT=

# Trust X-Forwarded-For / -Proto / -Host from reverse proxies you control:
# false, true (one proxy) or the number of proxies (e.g. 2 for CDN + nginx).
TRUST_PROXY=false

# Logging: debug | info | warn | error, and text | json.
LOG_LEVEL=info
LOG_FORMAT=text

# Memory cap for Redis (data is evicted, oldest-used first, beyond it).
REDIS_MAXMEMORY=512mb

# --- Hosting (see README → Hosting) -------------------------------------------
# Enable one option by uncommenting its lines. The command stays the same:
# docker compose up -d. Use ";" instead of ":" in COMPOSE_FILE on Windows.

# Cloudflare Quick Tunnel: no account, random URL (`make tunnel-url`).
#COMPOSE_FILE=docker-compose.yml:deploy/cloudflare/quick.yml

# Cloudflare Tunnel on your domain.
#COMPOSE_FILE=docker-compose.yml:deploy/cloudflare/compose.yml
#CLOUDFLARE_TUNNEL_TOKEN=
#DOMAIN=hooks.example.com

# ngrok.
#COMPOSE_FILE=docker-compose.yml:deploy/ngrok/compose.yml
#NGROK_AUTHTOKEN=
#NGROK_DOMAIN=example-name.ngrok-free.app

# Caddy with automatic HTTPS (ports 80 and 443 open, DNS pointing here).
#COMPOSE_FILE=docker-compose.yml:deploy/caddy/compose.yml
#DOMAIN=hooks.example.com
